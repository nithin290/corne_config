#include <behaviors.dtsi>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&bootloader  &none  &none  &none  &none              &none               &none  &none  &none  &none  &none  &bootloader
&none        &to 4  &to 3  &to 2  &to 1              &none               &none  &to 1  &to 2  &to 3  &to 4  &none
&sys_reset   &none  &none  &none  &ext_power EP_OFF  &ext_power EP_ON    &none  &none  &none  &none  &none  &sys_reset
                           &none  &none              &none               &none  &none  &none
            >;
        };

        qwerty {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R     &kp T      &kp Y      &kp U      &kp I      &kp O    &kp P     &kp GRAVE
&kp LCTRL  &kp A  &kp S  &kp D  &kp F     &kp G      &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp LALT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V     &kp B      &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp LGUI
                         &to 0  &kp BSPC  &kp ESC    &kp ENTER  &kp SPACE  &tog 3
            >;
        };

        gallium {
            bindings = <
&kp TAB    &kp B           &kp L           &kp D             &kp C               &kp V      &kp J      &kp F                &kp O              &kp U            &kp SEMI         &kp BACKSLASH
&kp LCTRL  &mt LEFT_GUI N  &mt LEFT_ALT R  &mt LEFT_SHIFT S  &mt LEFT_CONTROL T  &kp G      &kp Y      &mt RIGHT_CONTROL H  &mt RIGHT_SHIFT A  &mt RIGHT_ALT E  &mt RIGHT_GUI I  &kp RIGHT_ALT
&kp LSHFT  &kp X           &kp Q           &kp M             &kp W               &kp Z      &kp K      &kp P                &kp COMMA          &kp DOT          &kp QUESTION     &kp LEFT_WIN
                                           &to 0             &kp BSPC            &kp ESC    &kp ENTER  &kp SPACE            &tog 3
            >;
        };

        numbers {
            bindings = <
&none  &none   &kp N1  &kp N2  &kp N3    &none      &kp EXCLAMATION  &kp AT     &kp N3  &kp N4  &kp N5  &kp MINUS
&none  &none   &kp N4  &kp N5  &kp N6    &none      &kp N6           &kp N7     &kp N8  &kp N9  &kp N0  &kp EQUAL
&none  &kp N0  &kp N7  &kp N8  &kp N9    &none      &kp LBKT         &kp RBKT   &none   &none   &none   &none
                       &to 0   &kp BSPC  &kp ESC    &kp ENTER        &kp SPACE  &tog 3
            >;
        };

        navigation {
            bindings = <
&kp ESC    &none  &none  &none  &none          &none         &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none  &none
&kp LCTRL  &none  &none  &none  &none          &none         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none  &none
&kp LSHFT  &none  &none  &none  &none          &none         &none      &none      &none      &none      &none  &none
                         &to 0  &kp BACKSPACE  &kp ESCAPE    &kp ENTER  &kp SPACE  &none
            >;
        };
    };
};
